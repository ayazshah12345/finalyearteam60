datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  PLACEMENT_COORDINATOR
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

enum SubmissionType {
  PDF
  ZIP
  Code
  GitHub_Repository
}

enum SubmissionStatus {
  Draft
  Submitted
  Under_Review
  Returned
  Needs_Changes
  Graded
  Approved
  Closed
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  role         Role     @default(STUDENT)
  department   String
  batch        String?
  semester     Int?
  rollNumber   String?
  avatarUrl    String?
  cgpa         Float?
  backlogs     Int?
  bio          String?
  password     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessonProgress       LessonProgress[]
  submissions          Submission[]
  quizAttempts         QuizAttempt[]
  dailyReports         DailyReport[]
  codingProfile        CodingProfile?
  codingSubmissions    CodingSubmission[]
  portfolioItems       PortfolioItem[]
  resume               Resume?
  applications         PlacementApplication[]
  notifications        Notification[]
  auditLogs            AuditLog[]
}

model Course {
  id                 String     @id @default(uuid())
  title              String
  description        String
  category           String
  instructorId       String
  instructorName     String
  department         String
  durationHours      Int
  difficulty         Difficulty @default(Beginner)
  coverImage         String
  published          Boolean    @default(true)
  learningObjectives String[]
  skillsGained       String[]
  createdAt          DateTime   @default(now())

  modules        Module[]
  lessons        Lesson[]
  assignments    Assignment[]
  quizzes        Quiz[]
  lessonProgress LessonProgress[]
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String
  durationMinutes Int
  videoUrl        String?
  pdfUrl          String?
  pptUrl          String?
  notesContent    String?
  codeSnippet     String?
  order           Int
  createdAt       DateTime @default(now())

  progress LessonProgress[]
}

model LessonProgress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed         Boolean  @default(false)
  timeSpentSeconds  Int      @default(0)
  lastAccessedAt    DateTime @default(now())
  completedAt       DateTime?

  @@unique([userId, lessonId])
}

model Assignment {
  id             String         @id @default(uuid())
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle    String
  title          String
  description    String
  instructions   String
  totalMarks     Int
  dueDate        DateTime
  submissionType String
  published      Boolean        @default(true)
  createdBy      String
  createdAt      DateTime       @default(now())

  submissions Submission[]
}

model Submission {
  id                 String           @id @default(uuid())
  assignmentId       String
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName        String
  studentRollNumber  String
  department         String
  contentUrl         String?
  codeText           String?
  submissionType     String
  status             SubmissionStatus @default(Submitted)
  marksObtained      Int?
  feedback           String?
  submittedAt        DateTime         @default(now())
  gradedAt           DateTime?
  gradedBy           String?
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text          String
  options       String[]
  correctOption Int
  explanation   String?
  marks         Int      @default(1)
}

model Quiz {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String
  totalMarks   Int
  passingMarks Int
  timeLimitMin Int
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  questions Question[]
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id             String   @id @default(uuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Int
  totalMarks     Int
  passed         Boolean
  answers        Json
  timeTakenSec   Int
  completedAt    DateTime @default(now())
}

model DailyReport {
  id                 String   @id @default(uuid())
  studentId          String
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date               DateTime @default(now())
  tasksCompleted     String[]
  hoursSpent         Float
  keyLearnings       String
  blockers           String?
  selfRating         Int
  verificationStatus String   @default("Pending")
  verifiedBy         String?
  createdAt          DateTime @default(now())
}

model CodingProfile {
  id                   String   @id @default(uuid())
  studentId            String   @unique
  student              User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leetcodeUsername     String?
  leetcodeSolved       Int      @default(0)
  easyCount            Int      @default(0)
  mediumCount          Int      @default(0)
  hardCount            Int      @default(0)
  leetcodeRating       Int      @default(0)
  streakDays           Int      @default(0)
  codeforcesUsername   String?
  codeforcesRating     Int      @default(0)
  githubUsername       String?
  githubReposCount     Int      @default(0)
  githubCommitsThisYear Int     @default(0)
  overallCodeRating    Int      @default(0)
  verificationStatus   String   @default("Manual Entry")
  lastSyncedAt         DateTime @default(now())
}

model CodingProblem {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  difficulty       String             @default("Easy")
  topics           String[]
  description      String
  constraints      String[]
  starterCodeJson  Json
  sampleCasesJson  Json
  createdAt        DateTime           @default(now())
  submissions      CodingSubmission[]
}

model CodingSubmission {
  id               String        @id @default(uuid())
  studentId        String
  student          User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName      String
  problemId        String
  problem          CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemTitle     String
  language         String
  code             String
  status           String        @default("Accepted")
  testCasesPassed  Int           @default(0)
  totalTestCases   Int           @default(0)
  executionTimeMs  Int           @default(0)
  submittedAt      DateTime      @default(now())
}

model PortfolioItem {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  tags        String[]
  projectUrl  String?
  githubUrl   String?
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Resume {
  id               String   @id @default(uuid())
  studentId        String   @unique
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  headline         String?
  summary          String?
  education        Json
  experience       Json
  projects         Json
  skills           String[]
  certifications   Json
  atsScore         Int      @default(0)
  atsSuggestions   String[]
  updatedAt        DateTime @updatedAt
}

model Company {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  location    String?
  industry    String
  about       String

  drives PlacementDrive[]
}

model PlacementDrive {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName     String
  companyLogoUrl  String?
  roleTitle       String
  packageLPA      Float
  location        String
  jobDescription  String
  driveDate       DateTime
  deadlineDate    DateTime
  minCgpa         Float    @default(6.0)
  maxBacklogs     Int      @default(0)
  allowedDepts    String[]
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())

  applications PlacementApplication[]
}

model PlacementApplication {
  id          String         @id @default(uuid())
  driveId     String
  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  rollNumber  String
  department  String
  cgpa        Float
  backlogs    Int
  resumeUrl   String?
  status      String         @default("Applied")
  appliedAt   DateTime       @default(now())

  @@unique([driveId, studentId])
}

model AIKnowledgeSource {
  id          String   @id @default(uuid())
  title       String
  type        String
  url         String?
  content     String
  department  String
  courseId    String?
  uploadedBy  String
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  role      Role
  action    String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
}
